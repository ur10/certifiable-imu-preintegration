__pycache__/
*.pyc

# experiment outputs land next to the scripts; the reference copies live in results/
*.png
*.pdf
*.json
!results/*.json

# datasets are not vendored (see datasets.py)
data/
.venv/

# shipped outputs: the demo figures and data, and the re-runs under runs/
!demos/figures/*.png
!demos/out/*.json
!runs/**/*.json
!runs/**/*.png
!runs/**/*.pdf
*.log
