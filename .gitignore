__pycache__/
*.pyc

# experiment outputs land next to the scripts; the reference copies live in results/
*.png
*.pdf
*.json
!results/*.json

# datasets are not vendored (see datasets.py)
data/
.venv/
.venv-web/

# shipped outputs: the demo figures and data, and the re-runs under runs/
!demos/figures/*.png
!demos/out/*.json
!runs/**/*.json
!runs/**/*.png
!runs/**/*.pdf
*.log

# local only: unrelated capture data, regenerable Viser builds, solver caches
ur_human_capture/
demos/web/build/
demos/out/_partial_*.json
demos/out/sim_sdp_cache*.json
